diff -ruN '--exclude=obj' '--exclude=out' '--exclude=out_dbg' dcurrent/openbor/engine/web/web_shim.c work/ob/engine/web/web_shim.c
--- dcurrent/openbor/engine/web/web_shim.c	1969-12-31 19:00:00.000000000 -0500
+++ work/ob/engine/web/web_shim.c	2026-11-03 21:00:47.640621060 -0500
@@ -0,0 +1,15 @@
+/* Browser/WebAssembly shims for the OpenBOR web port. */
+#include <string.h>
+#include <sys/sysinfo.h>
+#include <emscripten.h>
+
+/* The engine sizes caches from system RAM. Report a fixed, modest budget
+ * (the wasm heap is capped, so real host RAM is irrelevant). */
+int sysinfo(struct sysinfo *info)
+{
+    memset(info, 0, sizeof(*info));
+    info->totalram = 1024UL * 1024UL * 1024UL;
+    info->freeram  = 768UL * 1024UL * 1024UL;
+    info->mem_unit = 1;
+    return 0;
+}
